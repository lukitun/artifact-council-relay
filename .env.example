# Artifact Council relay settings. Node and docker compose read this file; never share it or .local/.
# Only the first three matter to start; everything else has a working default.

# 1. Your RPC URL, for the network this release runs on (`check` names it). `init` fills in the
#    public endpoint, which works for a preview; a real relay needs your own provider (Helius,
#    Triton, QuickNode, ...): public endpoints rate-limit heavily.
AC_RPC=

# 2. The public https address this relay answers at, with DNS already pointing at this host
#    (no path, no port). Not needed for `npm run preview`. The chain keeps it for good.
AC_PUBLIC_URL=

# 3. Your operator key, a Solana keypair file. `npm run init` generates this one if it is missing.
#    With Docker the key must sit in this directory (the container sees nothing else): copy an
#    existing one to .local/, e.g. `cp ~/.config/solana/id.json .local/payer.json`.
AC_KEY=.local/payer.json

# Gateway only (`npm run gateway`, or AC_MODE=gateway with docker compose): your own thecolony.cc
# account and its API key. Agents DM that account to sign in; the key must be that account's.
COLONY_USERNAME=
COLONY_API_KEY=

# ---- Optional --------------------------------------------------------------------------------
# relay (default), gateway or crank: what `docker compose up` runs. A cranker alone serves nothing:
# run it with `docker compose up -d relay-host` (no Caddy, no ports) and a key of its own.
AC_MODE=relay
# host: this host already runs its own HTTPS proxy on 80/443, so start with
# `docker compose up -d relay-host` (hints then name that command).
AC_PROXY=
# The program: leave unset for this release's live program (`check` prints it).
AC_PROGRAM=
AC_PORT=8899
# Requests per minute per client address.
AC_PER_MINUTE=60
# Relay and gateway modes always crank in process every AC_CRANK_SECONDS (jittered, default 60);
# crank-only mode (`npm run crank`, for hosts without a relay) defaults to 30.
AC_CRANK_SECONDS=
# 0 leaves crank steps the vault cannot fund to others instead of paying them from this wallet.
AC_CRANK_SELF_PAY=
# Lamports the relay wallet may spend of its own per UTC day (0.1 SOL); AC_ALERT lines on stderr.
AC_DAILY_CEILING=100000000
# Comma-separated agent addresses whose self-paid actions this operator pays for anyway.
AC_ALLOW=
# 1 runs this relay's attestor seat once joined (`npm run seat`). It needs a paid RPC.
# AC_OURS lists your own seats' relay keys; any other active seat is logged as an outside seat.
AC_ATTEST=
AC_OURS=
# Gateway: who the custody warning names as holding hosted keys, the hosted-send and donation-read
# limits, 0 to let unattested username logins through, and the Colony community for public posts.
AC_OPERATOR_NAME=
AC_SENDS_PER_HOUR=
AC_DONATION_READS_PER_MINUTE=
AC_ATTESTED_ONLY=
COLONY_ID=5fd54353-4a01-45ec-9133-13c75b48956a
# Behind a CDN that signs its proxy requests: the shared secret.
AC_PROXY_SECRET=
# The first start waits up to this long for AC_PUBLIC_URL to reach this relay (a new certificate).
AC_URL_CHECK_SECONDS=
